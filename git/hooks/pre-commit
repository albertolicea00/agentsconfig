#!/usr/bin/env bash
# Global Git pre-commit hook: email privacy guard + forbidden/large file guard + Gitleaks + detect-secrets + repo-local hook chain
set -euo pipefail

# Ensure Homebrew, user-local, and Windows shim binaries are in PATH (for GUI Git clients)
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*|CYGWIN*)
        for win_dir in \
            "$HOME/scoop/shims" \
            "$HOME/AppData/Local/Microsoft/WinGet/Links" \
            "$HOME/AppData/Roaming/Python"/Python*/Scripts \
            "$HOME/AppData/Local/Programs/Python"/Python*/Scripts; do
            [ -d "$win_dir" ] && export PATH="$win_dir:$PATH"
        done
        ;;
esac

to_native_path() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s' "$1"
    fi
}

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
GIT_CONFIG_DIR="$(cd "$HOOK_DIR/.." && pwd -P)"
# shellcheck source=../scripts/hook-lib.sh
source "$GIT_CONFIG_DIR/scripts/hook-lib.sh"
DEFAULT_GITLEAKS_CONFIG="$(to_native_path "$GIT_CONFIG_DIR/gitleaks.toml")"

if hook_is_enabled "hooks.pre-commit.enabled"; then
    # 0. Block commits with non-protected author/committer email addresses
    if hook_is_enabled "hooks.pre-commit.emailGuard"; then
        DEFAULT_EMAIL_REGEX='@(users\.noreply\.(github|gitlab)\.com|noreply\.codeberg\.org)$'
        ALLOWED_EMAIL_REGEX="$(git config --get hooks.allowedEmailRegex 2>/dev/null | tr -d '\r' || true)"
        [ -z "$ALLOWED_EMAIL_REGEX" ] && ALLOWED_EMAIL_REGEX="$DEFAULT_EMAIL_REGEX"

        extract_ident_email() {
            local ident="$1"
            if [[ "$ident" == *"<"*">"* ]]; then
                ident="${ident#*<}"
                printf '%s' "${ident%%>*}" | tr -d '\r'
            fi
        }

        AUTHOR_IDENT="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
        COMMITTER_IDENT="$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)"
        AUTHOR_EMAIL="$(extract_ident_email "$AUTHOR_IDENT")"
        COMMITTER_EMAIL="$(extract_ident_email "$COMMITTER_IDENT")"
        if [ -z "$AUTHOR_EMAIL" ]; then
            AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$(git config --get user.email 2>/dev/null | tr -d '\r' || true)}"
        fi
        if [ -z "$COMMITTER_EMAIL" ]; then
            COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$(git config --get user.email 2>/dev/null | tr -d '\r' || true)}"
        fi

        BAD_EMAILS=()
        if [ -z "$AUTHOR_EMAIL" ] || ! printf '%s\n' "$AUTHOR_EMAIL" | grep -Eiq -- "$ALLOWED_EMAIL_REGEX"; then
            BAD_EMAILS+=("  - Author email   : ${AUTHOR_EMAIL:-<unset>}")
        fi
        if [ -z "$COMMITTER_EMAIL" ] || ! printf '%s\n' "$COMMITTER_EMAIL" | grep -Eiq -- "$ALLOWED_EMAIL_REGEX"; then
            BAD_EMAILS+=("  - Committer email: ${COMMITTER_EMAIL:-<unset>}")
        fi

        if [ "${#BAD_EMAILS[@]}" -gt 0 ]; then
            echo "ERROR: Commit blocked — non-protected email address detected:" >&2
            printf '%s\n' "${BAD_EMAILS[@]}" >&2
            echo "" >&2
            echo "Allowed pattern (hooks.allowedEmailRegex): $ALLOWED_EMAIL_REGEX" >&2
            echo "Set a noreply email: git config --global user.email \"<ID>+<user>@users.noreply.github.com\"" >&2
            echo "Or allow a repo-specific pattern: git config --local hooks.allowedEmailRegex '@company\\.com\$'" >&2
            echo "To disable in this repo: git config --local hooks.pre-commit.emailGuard false" >&2
            echo "To bypass once: git commit --no-verify" >&2
            exit 1
        fi
    fi

    # Collect staged files (Added, Copied, Modified, Renamed)
    STAGED_FILES=()
    while IFS= read -r -d '' file; do
        STAGED_FILES+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACMR -z)

    # 1. Block forbidden files (.env, OS metadata, private keys), nested Git repos, and oversized files
    if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
        CHECK_FORBIDDEN=0
        CHECK_NESTED=0
        CHECK_LARGE=0
        hook_is_enabled "hooks.pre-commit.forbiddenFiles" && CHECK_FORBIDDEN=1
        hook_is_enabled "hooks.pre-commit.nestedRepos" && CHECK_NESTED=1
        hook_is_enabled "hooks.pre-commit.largeFiles" && CHECK_LARGE=1

        MAX_FILE_SIZE_MB="$(git config --get hooks.maxFileSizeMB 2>/dev/null | tr -d '\r' || echo 5)"
        case "$MAX_FILE_SIZE_MB" in
            ''|*[!0-9]*) MAX_FILE_SIZE_MB=5 ;;
        esac
        MAX_FILE_SIZE_BYTES=$((MAX_FILE_SIZE_MB * 1024 * 1024))

        BLOCKED_FILES=()

        # Block accidental nested Git repositories (staged mode 160000 not registered in .gitmodules)
        if [ "$CHECK_NESTED" -eq 1 ]; then
            while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
                new_mode="${meta#* }"
                new_mode="${new_mode%% *}"
                if [ "$new_mode" = "160000" ]; then
                    is_submodule=0
                    if [ -f ".gitmodules" ]; then
                        if git config --file .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                            | tr -d '\r' \
                            | awk '{ $1=""; sub(/^ /, ""); print }' \
                            | grep -Fxq -- "$path"; then
                            is_submodule=1
                        fi
                    fi
                    if [ "$is_submodule" -eq 0 ]; then
                        BLOCKED_FILES+=("  - $path (nested Git repository; remove its .git folder or add it via 'git submodule add')")
                    fi
                fi
            done < <(git diff --cached --raw --no-renames -z --diff-filter=AM)
        fi

        if [ "$CHECK_FORBIDDEN" -eq 1 ] || [ "$CHECK_LARGE" -eq 1 ]; then
            for file in "${STAGED_FILES[@]}"; do
                if [ "$CHECK_FORBIDDEN" -eq 1 ]; then
                    base="$(basename "$file")"
                    base_lower="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"

                    case "$base_lower" in
                        .env.example|.env.sample|.env.template|.env.dist|.env.schema)
                            ;;
                        .env|.env.*)
                            BLOCKED_FILES+=("  - $file (forbidden .env file; use .env.example for templates)")
                            continue
                            ;;
                        .ds_store|thumbs.db|desktop.ini)
                            BLOCKED_FILES+=("  - $file (OS metadata file)")
                            continue
                            ;;
                        *.pem|*.key|*.p12|*.pfx|id_rsa|id_ed25519|id_ecdsa|id_dsa)
                            BLOCKED_FILES+=("  - $file (private key or certificate file)")
                            continue
                            ;;
                    esac
                fi

                if [ "$CHECK_LARGE" -eq 1 ] && [ "$MAX_FILE_SIZE_BYTES" -gt 0 ]; then
                    blob_size="$(git cat-file -s ":$file" 2>/dev/null | tr -d '\r' || echo 0)"
                    case "$blob_size" in
                        ''|*[!0-9]*) blob_size=0 ;;
                    esac
                    if [ "$blob_size" -gt "$MAX_FILE_SIZE_BYTES" ]; then
                        size_mb="$(awk -v b="$blob_size" 'BEGIN { printf "%.2f", b / 1048576 }')"
                        BLOCKED_FILES+=("  - $file (${size_mb} MB exceeds ${MAX_FILE_SIZE_MB} MB limit)")
                    fi
                fi
            done
        fi

        if [ "${#BLOCKED_FILES[@]}" -gt 0 ]; then
            echo "ERROR: Commit blocked — forbidden or oversized staged files detected:" >&2
            printf '%s\n' "${BLOCKED_FILES[@]}" >&2
            echo "" >&2
            echo "Unstage them with: git reset HEAD <file>" >&2
            echo "To adjust size limit for this repo: git config --local hooks.maxFileSizeMB <MB>" >&2
            echo "To bypass once: git commit --no-verify" >&2
            exit 1
        fi
    fi

    # 2. Run Gitleaks on staged changes
    if hook_is_enabled "hooks.pre-commit.gitleaks"; then
        if command -v gitleaks >/dev/null 2>&1; then
            if [ -f ".gitleaks.toml" ]; then
                GITLEAKS_CFG=".gitleaks.toml"
            else
                GITLEAKS_CFG="$DEFAULT_GITLEAKS_CONFIG"
            fi
            gitleaks git --pre-commit --redact --staged --verbose --config="$GITLEAKS_CFG"
        else
            echo "Warning: gitleaks not found in PATH — skipping gitleaks check." >&2
        fi
    fi

    # 3. Run detect-secrets-hook on staged files
    if hook_is_enabled "hooks.pre-commit.detectSecrets"; then
        if command -v detect-secrets-hook >/dev/null 2>&1; then
            if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
                LOCKFILE_REGEX='(?:^|/)(?:package-lock\.json|pnpm-lock\.yaml|yarn\.lock|Cargo\.lock|poetry\.lock|uv\.lock|skills-lock\.json|\.skill-lock\.json)$'
                if [ -f ".secrets.baseline" ]; then
                    detect-secrets-hook --baseline .secrets.baseline --exclude-files "$LOCKFILE_REGEX" "${STAGED_FILES[@]}"
                else
                    detect-secrets-hook --exclude-files "$LOCKFILE_REGEX" "${STAGED_FILES[@]}"
                fi
            fi
        else
            echo "Warning: detect-secrets-hook not found in PATH — skipping detect-secrets check." >&2
        fi
    fi
fi

# 4. Chain repository-local pre-commit hook if present
GIT_DIR="$(git rev-parse --git-dir 2>/dev/null | tr -d '\r' || true)"
if [ -n "$GIT_DIR" ]; then
    LOCAL_HOOK="$GIT_DIR/hooks/pre-commit"
    if [ -x "$LOCAL_HOOK" ] && [ "$(cd "$(dirname "$LOCAL_HOOK")" && pwd -P)/$(basename "$LOCAL_HOOK")" != "$HOOK_DIR/pre-commit" ]; then
        "$LOCAL_HOOK" "$@"
    fi
fi
